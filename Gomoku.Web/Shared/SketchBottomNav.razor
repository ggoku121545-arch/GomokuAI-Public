@inject Microsoft.AspNetCore.Components.NavigationManager Navigation

<nav class="sketch-bottom-nav" aria-label="주 메뉴">
    <button type="button" class="nav-home @(Active == "home" ? "active" : null)" aria-current="@(Active == "home" ? "page" : null)" @onclick="GoHome">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="home-fill" d="m2.8 10.9 9.2-8 9.2 8-1.9 2.1v8.1h-5v-6.4H9.7v6.4h-5V13Z" /><path d="m2.8 10.9 9.2-8 9.2 8M4.7 13v8.1h5v-6.4h4.6v6.4h5V13" /></svg>
        <span>홈</span>
    </button>
    <button type="button" class="@(Active == "game" ? "active" : null)" aria-current="@(Active == "game" ? "page" : null)" @onclick="GoGame">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8h10a5 5 0 0 1 4.8 6.5l-1.1 3.3a2 2 0 0 1-3.2.9L15 17H9l-2.5 1.7a2 2 0 0 1-3.2-.9l-1.1-3.3A5 5 0 0 1 7 8Z" /><path d="M7 12v4m-2-2h4m7-1h.01m3 2h.01" /></svg>
        <span>게임</span>
    </button>
    <button type="button" disabled title="보관함은 6단계에서 추가됩니다">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v15H4zM7 3h10v3H7z" /><path d="M9 11h6" /></svg>
        <span>보관함</span>
    </button>
    <button type="button" class="@(Active == "records" ? "active" : null)" aria-current="@(Active == "records" ? "page" : null)" @onclick="GoRecords">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20V10m7 10V4m7 16v-7" /></svg>
        <span>기록</span>
    </button>
</nav>

@code {
    [Parameter] public string Active { get; set; } = string.Empty;

    private void GoHome() => Navigation.NavigateTo(Navigation.BaseUri);
    private void GoGame() => Navigation.NavigateTo("games");
    private void GoRecords() => Navigation.NavigateTo("records");
}
