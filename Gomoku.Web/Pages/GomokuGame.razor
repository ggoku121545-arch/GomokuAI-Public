@page "/game/gomoku"
@implements IAsyncDisposable
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@inject PlayerStatsStore StatsStore
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>오목 한판</PageTitle>
<main class="game-shell" @ref="gameRoot">
    <header class="game-header">
        <button type="button" class="home-button" aria-label="홈으로 돌아가기" @onclick="GoHome">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5" />
                <path d="m11 18-6-6 6-6" />
            </svg>
            <span>홈</span>
        </button>
        <div class="game-title"><span class="eyebrow">15 × 15 오목</span><h1>오목 한판</h1></div>
        <div class="turn-badge" aria-live="polite"><span class="mini-stone @TurnStoneClass"></span>@Status</div>
    </header>

    <section class="theme-picker" aria-labelledby="theme-picker-title">
        <div class="theme-picker__heading">
            <h2 id="theme-picker-title">오목판 테마</h2>
            <span aria-live="polite">@selectedTheme.Name</span>
        </div>
        <div class="theme-options" role="radiogroup" aria-label="오목판 테마 선택">
            @foreach (var theme in BoardThemes.All)
            {
                <button @key="theme.Id"
                        type="button"
                        class="theme-option @(selectedTheme.Id == theme.Id ? "is-selected" : null)"
                        data-theme="@theme.Id"
                        role="radio"
                        aria-checked="@(selectedTheme.Id == theme.Id ? "true" : "false")"
                        title="@theme.Description"
                        @onclick="() => SelectTheme(theme)">
                    <span class="theme-preview" aria-hidden="true"></span>
                    <span class="theme-option__name">@theme.Name</span>
                </button>
            }
        </div>
    </section>

    <section class="board-wrap" data-board-theme="@selectedTheme.Id" aria-label="@($"{selectedTheme.Name} 오목판")">
        <div class="board" role="grid" aria-disabled="@(game.Result != GameResult.Playing || thinking)">
            @for (var row = 0; row < Game.BoardSize; row++)
            {
                @for (var column = 0; column < Game.BoardSize; column++)
                {
                    var r = row; var c = column; var position = new Position(r, c); var stone = game[r, c];
                    <button class="intersection @StoneClass(stone) @(game.LastMove == position ? "last" : "") @(game.WinningLine.Contains(position) ? "winner" : "")"
                            role="gridcell" aria-label="@(r + 1)행 @(c + 1)열 @StoneLabel(stone)" disabled="@(stone != Stone.Empty || game.Result != GameResult.Playing || thinking)"
                            @onclick="() => HumanMove(position)"><span class="stone"></span></button>
                }
            }
        </div>
    </section>

    <footer>
        <button class="action primary" @onclick="NewGame" disabled="@thinking">새 게임</button>
        <button class="action" @onclick="Undo" disabled="@(game.Moves.Count == 0 || thinking || game.Result != GameResult.Playing)">무르기</button>
    </footer>
    <p class="hint">흑돌을 놓아 다섯 개를 먼저 이어 보세요.</p>
</main>

@code {
    private readonly Game game = new();
    private readonly GomokuAi ai = new();
    private BoardTheme selectedTheme = BoardThemes.Default;
    private ElementReference gameRoot;
    private Microsoft.JSInterop.IJSObjectReference? audioModule;
    private bool thinking;
    private bool resultRecorded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            audioModule = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import", "./js/game-audio.js");
            await audioModule.InvokeVoidAsync("bindUnlock", gameRoot);
        }
        catch (Microsoft.JSInterop.JSException)
        {
            audioModule = null;
        }
    }

    private string Status => game.Result switch
    {
        GameResult.BlackWins => "흑 승리!",
        GameResult.WhiteWins => "백 승리",
        GameResult.Draw => "무승부",
        _ when thinking => "컴퓨터가 생각 중…",
        _ when game.CurrentTurn == Stone.Black => "내 차례 · 흑",
        _ => "컴퓨터 차례 · 백"
    };
    private string TurnStoneClass => game.Result == GameResult.Draw ? "empty" : game.Result == GameResult.WhiteWins || game.CurrentTurn == Stone.White ? "white" : "black";
    private static string StoneClass(Stone stone) => stone == Stone.Black ? "black" : stone == Stone.White ? "white" : "empty";
    private static string StoneLabel(Stone stone) => stone == Stone.Black ? "흑돌" : stone == Stone.White ? "백돌" : "빈 자리";

    private async Task HumanMove(Position position)
    {
        if (thinking || game.CurrentTurn != Stone.Black || !game.TryPlay(position)) return;
        await PlayGomokuPlaceAsync();

        if (game.Result != GameResult.Playing)
        {
            await RecordCompletedGameAsync();
            return;
        }

        thinking = true;
        StateHasChanged();
        try
        {
            await Task.Delay(180);
            var move = ai.ChooseMove(game);
            if (move is not null && game.TryPlay(move.Value)) await PlayGomokuPlaceAsync();
        }
        finally
        {
            thinking = false;
        }

        await RecordCompletedGameAsync();
    }

    private async Task RecordCompletedGameAsync()
    {
        if (resultRecorded || game.Result == GameResult.Playing) return;
        resultRecorded = true;

        var outcome = game.Result switch
        {
            GameResult.BlackWins => MatchOutcome.Win,
            GameResult.WhiteWins => MatchOutcome.Loss,
            _ => MatchOutcome.Draw
        };

        await StatsStore.RecordMatchAsync(outcome, game.Moves.Count, selectedTheme.Id);
    }

    private void SelectTheme(BoardTheme theme) => selectedTheme = theme;
    private void GoHome() => Navigation.NavigateTo(Navigation.BaseUri);
    private void NewGame() { game.Reset(); thinking = false; resultRecorded = false; }
    private void Undo() { if (!thinking && game.Result == GameResult.Playing) game.UndoRound(); }

    private async Task PlayGomokuPlaceAsync()
    {
        if (audioModule is null) return;
        try { await audioModule.InvokeVoidAsync("playGomokuPlace"); }
        catch (Microsoft.JSInterop.JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (audioModule is null) return;
        try { await audioModule.InvokeVoidAsync("unbindUnlock", gameRoot); await audioModule.DisposeAsync(); }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }
}
