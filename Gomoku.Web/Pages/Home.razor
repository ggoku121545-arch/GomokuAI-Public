@page "/"
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@inject PlayerStatsStore StatsStore
@inject PlayerSettingsStore SettingsStore

<PageTitle>GomokuAI 홈</PageTitle>

<main class="sketch-page home-page">
    <header class="home-header">
        <div class="home-title">
            <h1>HOME</h1>
        </div>
        <div class="header-actions" aria-label="홈 메뉴">
            <button type="button" aria-label="알림 - 준비 중" title="알림은 이후 단계에서 추가됩니다" disabled>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                    <path d="M10 21h4" />
                </svg>
                <span class="notification-dot" aria-hidden="true"></span>
            </button>
            <button type="button" aria-label="설정 열기" title="설정" @onclick="OpenSettings">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21h-4v-.09A1.7 1.7 0 0 0 8.6 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3v-4h.09A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3h4v.09A1.7 1.7 0 0 0 15.4 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.4 9c.12.4.34.75.66 1 .3.25.69.39 1.1.4H21v4h-.09a1.7 1.7 0 0 0-1.51.6Z" />
                </svg>
            </button>
        </div>
    </header>

    <section class="profile-card" aria-labelledby="player-name">
        <div class="profile-main">
            <div class="stone-avatar" aria-hidden="true">
                <span class="avatar-stone black"></span>
                <span class="avatar-stone white"></span>
            </div>
            <div class="profile-copy">
                <h2 id="player-name">@settings.PlayerName</h2>
                <p class="rank-line"><span class="rank-mark" aria-hidden="true">I</span><span>새싹 I · Lv.1</span></p>
                <div class="experience-row">
                    <div class="experience-track" role="progressbar" aria-label="경험치" aria-valuemin="0" aria-valuemax="1000" aria-valuenow="0">
                        <span></span>
                    </div>
                    <strong>0 / 1,000</strong>
                </div>
            </div>
        </div>

        <div class="stats-grid" aria-label="플레이어 전적">
            <div><strong>@TotalRecord</strong><span>총 전적</span></div>
            <div><strong>@WinRate</strong><span>승률</span></div>
            <div><strong>@(stats.CurrentWinStreak)연승</strong><span>연속 기록</span></div>
        </div>

        <div class="recent-form">
            <strong>최근 5경기</strong>
            <div aria-label="@RecentFormLabel">
                @for (var index = 0; index < 5; index++)
                {
                    if (index < stats.Matches.Count)
                    {
                        var outcome = stats.Matches[index].Outcome;
                        <span class="@MatchDisplay.OutcomeClass(outcome)">@MatchDisplay.OutcomeLetter(outcome)</span>
                    }
                    else
                    {
                        <span>–</span>
                    }
                }
            </div>
        </div>
    </section>

    <button type="button" class="quick-match" @onclick="StartGomoku">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m5 3 5 5-2 2-5-5V3h2Zm14 0-5 5 2 2 5-5V3h-2Z" />
            <path d="m9 11 4 4-2 2-4-4m8-2-4 4 2 2 4-4" />
            <path d="M9 17 6 20m9-3 3 3" />
        </svg>
        <span>빠른 대전</span>
        <b aria-hidden="true">›</b>
    </button>

    <section class="home-section" aria-labelledby="game-select-title">
        <div class="section-heading">
            <h2 id="game-select-title">게임 선택</h2>
            <span>다른 게임도 즐겨보세요 <b aria-hidden="true">›</b></span>
        </div>
        <div class="game-list">
            <button type="button" class="game-card gomoku-card" aria-label="AI 오목 시작" @onclick="StartGomoku">
                <div class="game-art board-art" aria-hidden="true">
                    <span class="mini-piece p1 black"></span>
                    <span class="mini-piece p2 white"></span>
                    <span class="mini-piece p3 black"></span>
                    <span class="mini-piece p4 white"></span>
                    <span class="mini-piece p5 black"></span>
                </div>
                <div class="game-card-copy">
                    <h3>오목</h3>
                    <p>가장 클래식한 두뇌 대결</p>
                </div>
                <span class="card-arrow" aria-hidden="true">›</span>
            </button>

            <article class="game-card">
                <div class="game-art flick-art" aria-hidden="true">
                    <span class="flick-black"></span>
                    <span class="flick-white"></span>
                    <i></i>
                </div>
                <div class="game-card-copy">
                    <h3>알까기</h3>
                    <p>손끝의 짜릿한 한 판</p>
                </div>
                <span class="card-arrow" aria-hidden="true">›</span>
            </article>

            <article class="game-card muted-card">
                <div class="game-art mystery-art" aria-hidden="true"><span>?</span></div>
                <div class="game-card-copy">
                    <h3>준비 중</h3>
                    <p>새로운 게임이<br />곧 찾아옵니다</p>
                </div>
            </article>
        </div>
    </section>

    <section class="home-section recent-section" aria-labelledby="recent-games-title">
        <div class="section-heading">
            <h2 id="recent-games-title">최근 경기</h2>
            <button type="button" class="section-link" @onclick="OpenRecords">더보기 <b aria-hidden="true">›</b></button>
        </div>
        @if (stats.Matches.Count == 0)
        {
            <div class="empty-history">
                <div class="recent-game-icon empty-preview" aria-hidden="true"><span></span><span></span></div>
                <div><strong>아직 경기 기록이 없어요</strong><p>첫 대전을 마치면 여기에 결과가 표시됩니다.</p></div>
            </div>
        }
        else
        {
            <div class="recent-match-list">
                @foreach (var match in stats.Matches.Take(2))
                {
                    <article class="recent-match">
                        <div class="recent-game-icon" aria-hidden="true"><span></span><span></span></div>
                        <div class="recent-match-copy">
                            <strong>오목</strong>
                            <span>vs AI · @(match.MoveCount)수 · @MatchDisplay.ThemeName(match.BoardThemeId)</span>
                        </div>
                        <div class="recent-result @MatchDisplay.OutcomeClass(match.Outcome)">
                            <strong>@MatchDisplay.OutcomeText(match.Outcome)</strong>
                            <time datetime="@match.PlayedAtUtc.ToString("O")">@MatchDisplay.RelativeTime(match.PlayedAtUtc)</time>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <SketchBottomNav Active="home" />
</main>

@code {
    private PlayerStats stats = new();
    private PlayerSettings settings = new();

    private string TotalRecord => stats.Draws == 0
        ? $"{stats.Wins}승 {stats.Losses}패"
        : $"{stats.Wins}승 {stats.Losses}패 {stats.Draws}무";
    private string WinRate => stats.TotalGames == 0 ? "--" : $"{stats.WinRatePercent}%";
    private string RecentFormLabel => stats.Matches.Count == 0
        ? "아직 경기 기록 없음"
        : $"최근 경기: {string.Join(", ", stats.Matches.Take(5).Select(match => MatchDisplay.OutcomeText(match.Outcome)))}";

    protected override async Task OnInitializedAsync()
    {
        stats = await StatsStore.LoadAsync();
        settings = await SettingsStore.LoadAsync();
    }

    private void StartGomoku()
    {
        Navigation.NavigateTo("game/gomoku");
    }

    private void OpenRecords() => Navigation.NavigateTo("records");
    private void OpenSettings() => Navigation.NavigateTo("settings");
}
