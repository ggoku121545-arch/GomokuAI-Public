@page "/"
@inject NavigationManager NavigationManager

<PageTitle>GomokuAI 홈</PageTitle>

<main class="home-shell">
    <section class="home-card" aria-labelledby="home-title">
        <p class="home-card__eyebrow">GOMOKU AI</p>
        <h1 id="home-title">새 홈 화면을 준비하고 있어요</h1>
        <p class="home-card__description">
            기존 AI 오목은 새 게임 주소로 안전하게 옮겼습니다.
        </p>
        <button type="button" class="home-card__play" @onclick="OpenGomoku">
            <span>AI 오목 시작</span>
            <span aria-hidden="true">→</span>
        </button>
    </section>
</main>

@code {
    private void OpenGomoku() => NavigationManager.NavigateTo("game/gomoku");
}
