@page "/games"
@implements IAsyncDisposable
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>게임 선택 · GomokuAI</PageTitle>

<main class="sketch-page games-page">
    <header class="subpage-header games-header">
        <button type="button" class="back-button" aria-label="홈으로 돌아가기" @onclick="GoHome">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5" /><path d="m11 18-6-6 6-6" /></svg>
        </button>
        <div><span>GAME SELECT</span><h1>게임</h1></div>
        <span class="games-count">@(orderedGames.Count)개</span>
    </header>

    <p class="games-hint">게임을 선택하거나, 칸을 길게 눌러 순서를 바꿔보세요.</p>

    <section @ref="gameList" class="game-options" aria-label="게임 선택 및 순서 변경">
        @foreach (var game in orderedGames)
        {
            <button @key="game.Id"
                    type="button"
                    class="game-option sketch-panel @(game.IsAvailable ? null : "coming-soon")"
                    data-game-id="@game.Id"
                    aria-label="@(game.IsAvailable ? $"{game.Name} 시작. 길게 눌러 순서 변경" : $"{game.Name}, 아직 준비 중. 길게 눌러 순서 변경")"
                    aria-disabled="@(!game.IsAvailable)"
                    @onclick="() => SelectGame(game)">
                <span class="game-illustration @game.IconClass" aria-hidden="true">
                    @if (game.Id == "gomoku")
                    {
                        <svg viewBox="0 0 100 100" class="mini-board" focusable="false">
                            <path d="M8 18 90 9M5 37 93 27M2 56 96 46M0 75 98 65M7 94 99 84M14 7 6 94M35 4 28 92M56 2 51 90M77 0 73 88M96 3 94 85" />
                            <circle class="stone-black" cx="36" cy="29" r="9" /><circle class="stone-white" cx="57" cy="49" r="9" />
                            <circle class="stone-black" cx="18" cy="52" r="9" /><circle class="stone-white" cx="39" cy="50" r="9" />
                            <circle class="stone-black" cx="55" cy="69" r="9" /><circle class="stone-white" cx="76" cy="67" r="9" />
                        </svg>
                    }
                    else if (game.Id == "alkagi")
                    {
                        <svg viewBox="0 0 100 100" class="clash-art" focusable="false">
                            <path class="spark-lines" d="M45 45 40 9M52 41 59 7M59 44 81 17M63 52 96 45M39 43 20 18" />
                            <ellipse class="stone-black" cx="36" cy="58" rx="25" ry="27" />
                            <ellipse class="stone-white" cx="69" cy="64" rx="24" ry="25" />
                            <path class="impact-star" d="m52 49 4 9 7-5-4 9 9 3-10 2 2 10-7-8-6 8 2-10-10-2 10-3-4-8 7 4z" />
                        </svg>
                    }
                    else if (game.Id == "othello")
                    {
                        <svg viewBox="0 0 100 100" class="mini-board othello-board" focusable="false">
                            <path d="M8 10v80M25 10v80M42 10v80M59 10v80M76 10v80M92 10v80M8 10h84M8 27h84M8 44h84M8 61h84M8 78h84M8 90h84" />
                            <circle class="stone-black" cx="42" cy="44" r="8"/><circle class="stone-white" cx="59" cy="44" r="8"/>
                            <circle class="stone-white" cx="42" cy="61" r="8"/><circle class="stone-black" cx="59" cy="61" r="8"/>
                        </svg>
                    }
                    else if (game.Id == "eraser")
                    {
                        <svg viewBox="0 0 100 100" class="eraser-art" focusable="false">
                            <path class="eraser-trail" d="M10 76q17 8 30-1M59 25q14-14 27-13" />
                            <g transform="rotate(-21 39 56)"><rect class="eraser-blue" x="9" y="39" width="60" height="34" rx="8"/><path d="M18 46v20" class="eraser-mark-blue"/><text x="43" y="60">1P</text></g>
                            <g transform="rotate(17 66 51)"><rect class="eraser-red" x="37" y="31" width="56" height="32" rx="8"/><path d="M45 37v20" class="eraser-mark-red"/><text x="69" y="51">2P</text></g>
                        </svg>
                    }
                    else if (game.Id == "eraser-push")
                    {
                        <svg viewBox="0 0 100 100" class="push-art" focusable="false">
                            <path class="push-desk-lines" d="M8 22 86 15M8 39 86 32M8 57 86 49M8 75 86 67M8 91 86 84" />
                            <path class="push-edge-line" d="M77 12v76M83 13v76" />
                            <path class="push-trail" d="M18 53q18 4 33-4" />
                            <g transform="rotate(-8 47 48)"><rect class="push-eraser" x="35" y="39" width="25" height="17" rx="3"/><path class="push-mark" d="M41 42v11"/></g>
                            <path class="push-arrow" d="m25 47-7 5 7 5" />
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 100 100" class="coming-art" focusable="false">
                            <ellipse cx="37" cy="63" rx="24" ry="15" />
                            <circle cx="69" cy="43" r="24" />
                        </svg>
                    }
                </span>
                <span class="game-option-copy">
                    <strong>@game.Name</strong>
                    <span>@game.Description</span>
                </span>
                <span class="game-option-actions" aria-hidden="true">
                    <span class="drag-grip"><i></i><i></i><i></i></span>
                    <span class="game-arrow">@(game.IsAvailable ? "›" : "· · ·")</span>
                </span>
            </button>
        }
    </section>

    <p class="games-order-note">순서는 이 기기에 저장됩니다.</p>
    <SketchBottomNav Active="game" />
</main>

@code {
    private static readonly GameOption[] GameCatalog =
    [
        new("gomoku", "오목", "AI와 두는 클래식 오목", "●", "gomoku-icon", true, "game/gomoku"),
        new("alkagi", "알까기", "돌을 튕겨 상대 돌을 밀어내세요", "◉", "alkagi-icon", true, "game/alkagi"),
        new("othello", "오델로", "AI 또는 2인 대전 · 8×8 돌 뒤집기", "◐", "othello-icon", true, "game/othello"),
        new("eraser", "지우개 따먹기", "각도를 맞춰 상대 지우개 위에 포개세요", "▰", "eraser-icon", true, "game/eraser"),
        new("eraser-push", "지우개 밀기", "책상 끝에 아슬아슬하게 세워보세요", "▱", "eraser-push-icon", true, "eraser-push.html"),
        new("coming-soon", "준비 중", "새로운 게임이 곧 찾아옵니다", "…", "soon-icon", false, string.Empty)
    ];

    private readonly string[] defaultOrder = ["gomoku", "alkagi", "othello", "eraser", "eraser-push", "coming-soon"];
    private string[] gameOrder = ["gomoku", "alkagi", "othello", "eraser", "eraser-push", "coming-soon"];
    private ElementReference gameList;
    private Microsoft.JSInterop.IJSObjectReference? module;
    private Microsoft.JSInterop.DotNetObjectReference<Games>? dotNetReference;
    private bool orderLoaded;
    private bool reorderEnabled;

    private IReadOnlyList<GameOption> orderedGames => gameOrder
        .Select(id => GameCatalog.First(game => game.Id == id))
        .ToArray();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import", "./js/game-menu.js");
            dotNetReference = Microsoft.JSInterop.DotNetObjectReference.Create(this);
            gameOrder = await module.InvokeAsync<string[]>("loadOrder", new object?[] { defaultOrder });
            orderLoaded = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (orderLoaded && !reorderEnabled && module is not null && dotNetReference is not null)
        {
            await module.InvokeVoidAsync("enableReorder", gameList, dotNetReference, gameOrder);
            reorderEnabled = true;
        }
    }

    private void SelectGame(GameOption game)
    {
        if (game.IsAvailable) Navigation.NavigateTo(game.Route, game.Id == "eraser-push");
    }

    private void GoHome() => Navigation.NavigateTo(Navigation.BaseUri);

    [Microsoft.JSInterop.JSInvokable]
    public Task OnGameOrderChanged(string[] order)
    {
        if (order.Length != GameCatalog.Length || order.Distinct(StringComparer.Ordinal).Count() != GameCatalog.Length ||
            order.Any(id => !GameCatalog.Any(game => game.Id == id))) return Task.CompletedTask;

        gameOrder = order;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("disableReorder", gameList); await module.DisposeAsync(); }
            catch (Microsoft.JSInterop.JSException) { }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
        dotNetReference?.Dispose();
    }

    private sealed record GameOption(string Id, string Name, string Description, string Icon, string IconClass, bool IsAvailable, string Route);
}
